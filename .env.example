# ArogyaGrid Environment Configuration
# Copy this to .env and fill in your values.

# ── Google AI ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_REGION=us-central1

# ── Provider Switches ─────────────────────────────────────────────────────
# Set to true to use real GCP APIs instead of stubs.
USE_REAL_GEMINI=true        # Uses google-generativeai SDK with GOOGLE_API_KEY
USE_REAL_FORECAST=false     # Stub: local heuristic → Real: BigQuery ML ARIMA_PLUS
USE_REAL_OCR=false          # Stub: Gemini multimodal → Real: Document AI
USE_REAL_IMAGEN=false       # Stub: Pillow render → Real: Imagen 3 via Vertex AI
USE_REAL_TRANSLATE=false    # Stub: Gemini translation → Real: Cloud Translation API

# ── Application ────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
DEMO_LANGUAGE=en
STOCKOUT_LEAD_DAYS=14
SAFETY_STOCK_DAYS=7
